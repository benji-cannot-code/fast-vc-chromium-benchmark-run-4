import("//build/config/features.gni")
import("//build/config/linux/pkg_config.gni")

# CrOS doesn't install GTK, gconf or any gnome packages.
assert(!is_chromeos && use_gconf)

pkg_config("gconf") {
  packages = [ "gconf-2.0" ]
  defines = [ "USE_GCONF" ]
}
