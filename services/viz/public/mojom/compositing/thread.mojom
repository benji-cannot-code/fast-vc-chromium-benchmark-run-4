module viz.mojom;

// Chrome may use Android PerformanceHint API differently for different thread
// types, thus threads need to be classified.
enum ThreadType {
    kMain,
    kIO,
    kCompositor,
    kVideo,
    kOther,
};

struct Thread {
    int32 id;
    ThreadType type;
};