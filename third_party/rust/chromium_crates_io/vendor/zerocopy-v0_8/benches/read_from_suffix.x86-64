bench_read_from_suffix_static_size:
	mov rcx, rsi
	cmp rsi, 6
	jb .LBB5_2
	mov eax, dword ptr [rdi + rsi - 6]
	movzx ecx, word ptr [rdi + rsi - 2]
	shl rcx, 32
	or rcx, rax
.LBB5_2:
	shl rcx, 16
	inc rcx
	xor eax, eax
	cmp rsi, 6
	cmovae rax, rcx
	ret
