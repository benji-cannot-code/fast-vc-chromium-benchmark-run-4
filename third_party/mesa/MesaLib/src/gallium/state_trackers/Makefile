FASTVC-BENCH-CORPUS:chromium-main-v1-943b94ae-1c74-4335-94fa-ceb4d277cea8
TOP = ../../..
include $(TOP)/configs/current


SUBDIRS = $(GALLIUM_STATE_TRACKERS_DIRS)


default: subdirs


subdirs:
	@for dir in $(SUBDIRS) ; do \
		if [ -d $$dir ] ; then \
			(cd $$dir && $(MAKE)) || exit 1 ; \
		fi \
	done


clean:
	rm -f `find . -name \*.[oa]`
	rm -f `find . -name depend`


# Dummy install target
install:
