[binaries]
c = 'clang-cl'
ar = 'llvm-ar'
exe_wrapper = 'wine'

[properties]
needs_exe_wrapper = true
c_args = ['-m32', '-fuse-ld=lld',]


[host_machine]
system = 'win'
cpu_family = 'x86'
cpu = 'i686'
endian = 'little'
c_winlibs = []
