// http://mozvr.github.io/webvr-spec/webvr.html#vrfieldofview
[
    RuntimeEnabled=VRDevice,
    GarbageCollected
] dictionary VRFieldOfViewInit {
    double upDegrees = 0.0;
    double rightDegrees = 0.0;
    double downDegrees = 0.0;
    double leftDegrees = 0.0;
};
