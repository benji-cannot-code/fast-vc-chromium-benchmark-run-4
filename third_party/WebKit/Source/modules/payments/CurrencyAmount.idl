// http://wicg.github.io/paymentrequest/specs/paymentrequest.html#idl-def-currencyamount

[
    RuntimeEnabled=PaymentRequest
] dictionary CurrencyAmount {
    required DOMString currencyCode;
    required DOMString value;
};
