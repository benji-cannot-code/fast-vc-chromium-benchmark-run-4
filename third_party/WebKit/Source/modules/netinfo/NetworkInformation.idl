enum ConnectionType {
    "cellular",
    "bluetooth",
    "ethernet",
    "wifi",
    "other",
    "none",
    "unknown"
};

[
    RuntimeEnabled=NetworkInformation,
    Exposed=(Window,Worker),
    WillBeGarbageCollected,
    ActiveDOMObject
] interface NetworkInformation : EventTarget {
    readonly attribute ConnectionType type;
    attribute EventHandler ontypechange;
};

