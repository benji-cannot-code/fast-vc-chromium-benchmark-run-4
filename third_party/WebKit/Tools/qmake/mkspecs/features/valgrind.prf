# -------------------------------------------------------------------
# This optional feature file adds rules that make running valgrind
# on QtWebKit easier.
#
# See 'Tools/qmake/README' for an overview of the build system
# -------------------------------------------------------------------

QMAKE_CXXFLAGS += -g
QMAKE_LFLAGS += -g
DEFINES += USE_SYSTEM_MALLOC=1
DEFINES += ENABLE_JIT=0
