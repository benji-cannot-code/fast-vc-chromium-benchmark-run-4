FASTVC-BENCH-CORPUS:chromium-main-v1-943b94ae-1c74-4335-94fa-ceb4d277cea8
#!/bin/sh

for framework in $*; do
    echo -e "\n$framework\n=================="
    for ext in cpp h; do
        find . -name "*.$ext" -exec grep $framework {} ';' | grep include | sed -e 's|.*/\(.*\.h\).*|\1|'
    done | sort | uniq
done
