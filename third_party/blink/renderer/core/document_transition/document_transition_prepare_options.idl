enum RootTransitionType {
  "none",
  "cover-down",
  "cover-left",
  "cover-right",
  "cover-up",
  "explode",
  "fade",
  "implode",
  "reveal-down",
  "reveal-left",
  "reveal-right",
  "reveal-up"
};

dictionary DocumentTransitionPrepareOptions {
  RootTransitionType rootTransition;
  sequence<Element?> sharedElements;
  AbortSignal abortSignal;
};
