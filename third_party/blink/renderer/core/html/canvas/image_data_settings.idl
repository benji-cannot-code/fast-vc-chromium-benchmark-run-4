enum PredefinedColorSpace {
    "srgb", // default
    "rec2020",
    "display-p3",
};

enum ImageDataStorageFormat {
  "uint8", // default
  "uint16",
  "float32",
};

dictionary ImageDataSettings {
  PredefinedColorSpace colorSpace = "srgb";
  [RuntimeEnabled=CanvasColorManagement] ImageDataStorageFormat storageFormat = "uint8";
};
