// https://wicg.github.io/fenced-frame/#fence-interface

typedef (FenceEvent or DOMString) ReportEventType;

[Exposed=Window, RuntimeEnabled=FencedFrames]
interface Fence {
    [RaisesException, DeprecateAs=HTMLFencedFrameElement] void reportEvent(ReportEventType event);
    [RaisesException, DeprecateAs=HTMLFencedFrameElement] void setReportEventDataForAutomaticBeacons(FenceEvent event);
    [RaisesException, DeprecateAs=HTMLFencedFrameElement] sequence<FencedFrameConfig> getNestedConfigs();
};
