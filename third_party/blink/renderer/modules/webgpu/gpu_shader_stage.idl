typedef unsigned long GPUShaderStageFlags;
[
    RuntimeEnabled=WebGPU
] interface GPUShaderStage {
    const unsigned long NONE = 0;
    const unsigned long VERTEX = 1;
    const unsigned long FRAGMENT = 2;
    const unsigned long COMPUTE = 4;
};
