[
    Exposed(Window WebGPU, Worker WebGPU)
] interface GPUAdapter {
    readonly attribute DOMString name;

    [CallWith=ScriptState] Promise<GPUDevice> requestDevice(optional GPUDeviceDescriptor descriptor = {});
};
