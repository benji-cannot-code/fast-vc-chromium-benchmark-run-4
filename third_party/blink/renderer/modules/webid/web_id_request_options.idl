// https://github.com/WICG/WebID

enum Mode {
  "mediated",
  "permission"
};

dictionary WebIdRequestOptions {
  // URL for the Identity Provider.
  required USVString provider;
  USVString client_id;
  USVString nonce;
  Mode mode = "permission";
};
