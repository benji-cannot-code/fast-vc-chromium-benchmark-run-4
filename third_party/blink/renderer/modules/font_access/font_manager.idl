// https://wicg.github.io/local-font-access/
[
    Exposed=(Window,Worker),
    SecureContext,
    RuntimeEnabled=FontAccess
] interface FontManager {
    [CallWith=ScriptState, RaisesException, Measure] Promise<sequence<FontMetadata>> query(optional QueryOptions options = {});
};
