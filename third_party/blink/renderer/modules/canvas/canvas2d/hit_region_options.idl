// Spec: https://html.spec.whatwg.org/C/#hitregionoptions

dictionary HitRegionOptions {
    Path2D? path = null;
    CanvasFillRule fillRule = "nonzero";
    DOMString id = "";
    Element? control = null;
    // We don't use parentID, label and role yet.
};
