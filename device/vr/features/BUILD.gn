import("features.gni")
import("//build/buildflag_header.gni")

# Generate a buildflag header for compile-time checking of WebVR support.
buildflag_header("features") {
  header = "features.h"
  flags = [
    "ENABLE_VR=$enable_vr",
    "ENABLE_OPENVR=$enable_openvr",
  ]
}
