module shadowing_unittest_enum.mojom;

// Tests that an enum named `Context` does not collide with the generic
// context type parameter in PrimitiveEnum derive macros.
enum Context {
  kBrowser = 0,
  kPrivilegedUtility = 1,
  kLowest = 2,
};
