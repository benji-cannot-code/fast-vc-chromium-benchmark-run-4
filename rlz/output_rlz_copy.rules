<?xml version="1.0" encoding="utf-8"?>
<VisualStudioToolFile
	Name="Output RLZ copy"
	Version="8.00"
	>
	<Rules>
		<CustomBuildRule
			Name="Output RLZ copy"
			CommandLine="$(SolutionDir)..\rlz\copy_files.bat $(ProjectDir)Binaries\* $(OutDir)"
			Outputs="$(OutDir)\$(InputFileName)"
			FileExtensions="*.dll;*.pdb"
			>
			<Properties>
			</Properties>
		</CustomBuildRule>
	</Rules>
</VisualStudioToolFile>
