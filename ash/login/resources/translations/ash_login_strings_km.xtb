        <ph name="BEGIN_PARAGRAPH2" />AI ដែលមាន​សមត្ថភាព​បង្កើត​គឺជាកំណែពិសោធន៍ ស្ថិតក្នុង​ដំណាក់កាល​អភិវឌ្ឍន៍​ដំបូង និង​អាចឱ្យប្រើបាន​ដោយមានដែនកំណត់នាពេលបច្ចុប្បន្ន។<ph name="END_PARAGRAPH2" /></translation>
<translation id="936479314588646618">រៀបចំ <ph name="DEVICE_TYPE" /> របស់អ្នកយ៉ាងងាយស្រួលដោយប្រើទូរសព្ទរបស់អ្នក។ អ្នកអាច​បញ្ចូល​គណនី Google របស់អ្នក​ដោយមិន​ចាំបាច់​បញ្ចូល​ពាក្យសម្ងាត់​របស់អ្នក​ដោយ​ផ្ទាល់ដៃ។
        <ph name="BR" />
        <ph name="BR" />
        មើលឃើញជា <ph name="DEVICE_TYPE" />...</translation>
</translationbundle>