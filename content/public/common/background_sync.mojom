module content;

enum BackgroundSyncNetworkState {
  ANY,
  AVOID_CELLULAR,
  ONLINE,
  MAX=ONLINE
};

struct SyncRegistration {
  int64 handle_id = -1;
  string tag = "";
  BackgroundSyncNetworkState network_state = ONLINE;
};
