module mojo_bindings_test.mojom;

struct TestStruct {
  enum StructEnum {
    kZero = 0,
    kOne  = 1,
  };

  const int32 kStructConst = 2;

  int32 x;
  int32 y = kStructConst;
  StructEnum z = StructEnum.kOne;
