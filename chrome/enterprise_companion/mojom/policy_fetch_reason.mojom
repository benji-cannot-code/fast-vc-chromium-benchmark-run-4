module enterprise_companion.mojom;

// A specific reason for the client to initiate the policy fetch request.
[Stable, Extensible]
enum PolicyFetchReason {
    [Default] UNSPECIFIED = 0,
    USER_REQUEST,
    SCHEDULED,
};
