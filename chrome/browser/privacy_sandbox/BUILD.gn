assert(!is_ios)

group("privacy_sandbox") {
  public_deps = [
    "notice",
    "notice:core",
    "notice:interfaces",
  ]

  # (Desktop Only)
  if (!is_android) {
    public_deps += [ "notice:desktop_view_manager" ]
  }
}

group("unit_tests") {
  testonly = true
  deps = [ "notice:unit_tests" ]
  public_deps = [ "notice:test_support" ]
}

group("browser_tests") {
  testonly = true
  deps = [ "notice:browser_tests" ]
}
