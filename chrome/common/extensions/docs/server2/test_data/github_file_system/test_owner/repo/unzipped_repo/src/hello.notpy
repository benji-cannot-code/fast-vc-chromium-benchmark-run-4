#!/usr/bin/env python

import random


def main(argv, argc):
   if argc == 0:
      print 'Hello, world!'
      print 'usage: hello.py [names]'
   else:
      print 'Hello, %s!' % random.choice(argv[1:])


if __name__ == '__main__':
   import sys
   main(sys.argv, len(sys.argv))
