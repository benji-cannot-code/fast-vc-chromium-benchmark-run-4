[internal, nodoc] namespace app.currentWindowInternal {
  interface Functions {
    // Focus the window.
    static void focus();

    // Minimize the window.
    static void minimize();

    // Maximize the window.
    static void maximize();

    // Restore the window.
    static void restore();

    // Draw attention to the window.
    static void drawAttention();

    // Clear attention to the window.
    static void clearAttention();
  };
};
