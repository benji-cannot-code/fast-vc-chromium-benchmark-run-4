module keyboard;

interface KeyboardUIHandlerMojo {
  SetTextInputTypeObserver(TextInputTypeObserver observer);

  SendKeyEvent(string? event_type,
               int32 char_value,
               int32 key_code,
               string? key_name,
               int32 modifiers);

  HideKeyboard();
};

interface TextInputTypeObserver {
  OnTextInputTypeChanged(string? input_type);
};
