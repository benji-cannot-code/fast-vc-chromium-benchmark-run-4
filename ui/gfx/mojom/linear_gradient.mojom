module gfx.mojom;

// See ui/gfx/geometry/linear_gradient.h.
struct Step {
  float fraction;
  uint8 alpha;
};

struct LinearGradient {
  int16 angle = 0;
  uint8 step_count = 0;
  array<Step, 6> steps;
};
