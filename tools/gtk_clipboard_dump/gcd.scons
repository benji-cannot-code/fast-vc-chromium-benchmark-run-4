FASTVC-BENCH-CORPUS:chromium-main-v1-943b94ae-1c74-4335-94fa-ceb4d277cea8
Import('env')

if not env.Bit('linux'):
  Return()

env = env.Clone()

env.Prepend(
    CPPPATH = [
        '$CHROME_SRC_DIR',
    ],
)

input_files = [
    'gtk_clipboard_dump.cc',
]

env.ChromeProgram('gtk_clipboard_dump', input_files)

