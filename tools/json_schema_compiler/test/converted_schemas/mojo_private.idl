// The chrome.mojoPrivate API provides access to the mojo modules.
namespace mojoPrivate {
  interface Functions {
    // Returns a promise that will resolve to an asynchronously
    // loaded module.
    [nocompile] static any requireAsync(DOMString name);
  };

};
