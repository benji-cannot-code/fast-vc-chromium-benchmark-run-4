# Fuzzer dictionary for URI template parser

# Variable expressions
"{foo}"
"{+foo}"
"{#foo}"
"{.foo}"
"{/foo}"
"{;foo}"
"{?foo}"
"{&foo}"
"{foo,bar}"
"{?foo,bar,baz}"
"?{foo,bar,baz}"

# Variable names
"foo"
"bar"
"baz"

# Variable values
" "
"%"
"%31"
"\x80"

# Magic end of string marker used by FuzzedDataProvider
"\\a"
