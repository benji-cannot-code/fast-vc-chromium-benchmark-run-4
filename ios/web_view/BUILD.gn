# Public target that should be used to depend on web_view. Only give access
# to the web_view public headers while still linking with the implementation.
group("web_view") {
  public_deps = [
    "//ios/web_view/public",
  ]
  deps = [
    "//ios/web_view/internal",
  ]
}
