source_set("search") {
  configs += [ "//build/config/compiler:enable_arc" ]
  sources = [
    "search_service.h",
    "search_service.mm",
  ]

  deps = [ "//components/keyed_service/core" ]
}

source_set("search_factory") {
  configs += [ "//build/config/compiler:enable_arc" ]
