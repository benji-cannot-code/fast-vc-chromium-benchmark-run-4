<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="km">
<translation id="1363028406613469049">សំឡេង</translation>
<translation id="1554523534964039554">ចែករំលែក​ពាក្យ​សម្ងាត់​ជាមួយ​ក្រុម​គ្រួសារ​របស់អ្នក</translation>
<translation id="2319645462410562206">Chrome អាច​រកឃើញ​លេខ​តាមដាន​ដែលអ្នក​បញ្ចូល​នៅលើ​គេហទំព័រ និង​បង្ហាញ​ព័ត៌មានថ្មីៗ​អំពី​កញ្ចប់​នៅលើ​ទំព័រ​ផ្ទាំង​ថ្មីបាន។</translation>
<translation id="2551790923936684824">តាមដាន​កញ្ចប់នេះ​ឬ?</translation>
<translation id="2734585994146185878">កញ្ចប់​ទំនិញ​របស់អ្នក</translation>
<translation id="282865025718505166">1ZX32F000348211000</translation>
<translation id="3092996224604267355">ថ្ងៃពុធ ទី 01 ខែឧសភា ត្រឹមម៉ោង 7:00 យប់</translation>
<translation id="3770157741494890119">អនុញ្ញាតឱ្យ Chrome តាមដាន​កញ្ចប់​របស់អ្នក។</translation>
<translation id="5475069061743940393">ការតាមដាន​កញ្ចប់</translation>
<translation id="5777468213129569553">បើក Chrome</translation>
<translation id="6147071803535394951">មើលឃើញ​ព័ត៌មានថ្មីៗ​អំពី​កញ្ចប់​នៅក្នុង​កាត​នៅលើ​ទំព័រ​ផ្ទាំងថ្មី​របស់អ្នក។</translation>
<translation id="6494974875566443634">ការ​ប្ដូរ​តាម​បំណង</translation>
<translation id="7108338896283013870">លាក់</translation>
<translation id="7343651556898151354">Chrome អាចជួយអ្នក​ក្នុងការ​តាមដាន​កញ្ចប់នេះ​នៅលើ​ទំព័រផ្ទាំង​ថ្មីបាន។</translation>
<translation id="8094734579697217987">ងាយស្រួល​ចែករំលែក​ច្បាប់ចម្លង​ពាក្យ​សម្ងាត់​ដោយ​សុវត្ថិភាព​ជាមួយ​ក្រុម​គ្រួសារ​របស់អ្នក​នៅក្នុង​កម្មវិធី​គ្រប់គ្រង​ពាក្យសម្ងាត់។</translation>
<translation id="9085041112720733880">បញ្ចូល​លេខ​តាមដាន​របស់អ្នក​នៅលើ​គេហទំព័រ​សម្រាប់​ទិញទំនិញ ឬ​ប្រៃសណីយ៍។</translation>
<translation id="9093047661118118915">ពេលដឹកជញ្ជូនដល់​ប៉ាន់ស្មាន</translation>
</translationbundle>