<!DOCTYPE translationbundle>
<translationbundle lang="km">
<translation id="1848444672771235816">Chrome៖ សកម្មភាពរហ័ស</translation>
<translation id="6834084925134176532">ដើម្បី​បន្តប្រើ​ធាតុ​ក្រាហ្វិកនេះ សូមចុច "កែ" នៅផ្នែក​ខាងក្រោម​នៃអេក្រង់ រួចចុច +។ ចូល​ទៅកាន់ Chrome រួចជ្រើសរើស​សកម្មភាពរហ័ស។</translation>
</translationbundle>