module cc.mojom;

struct LocalFrameId {
  // An identifier allocated by the client uniquely identifying a surface within
  // a client process.
  uint32 local_id;

  // A cryptographically secure random int chosen to make the LocalFrameId
  // unguessable by other clients.
  uint64 nonce;
};

